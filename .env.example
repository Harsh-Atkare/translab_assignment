GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=4


CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

CHROMA_COLLECTION=documents

APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
MAX_UPLOAD_MB=20

EMBED_CONCURRENCY=8
EMBED_RPM=90

MAX_OUTPUT_TOKENS=2048
THINKING_BUDGET=0

REQUEST_TIMEOUT=120
