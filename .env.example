# Copy to .env and fill in the key. .env is gitignored - never commit it.
# Free key, no credit card: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Run `make models` to see what your key can actually use, then set these.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768

# Retrieval tuning
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=4

# Storage (left as-is for local runs; the Dockerfile overrides them)
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# Collection name inside Chroma. Rarely worth changing - a different name is
# a different index, so the documents you already uploaded disappear.
CHROMA_COLLECTION=documents

APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
MAX_UPLOAD_MB=20

# Embedding throughput. Only matters when your embedding model doesn't batch
# (the app logs "does not batch" when it detects that). Raise concurrency on
# a paid key; lower EMBED_RPM if you start seeing 429s.
EMBED_CONCURRENCY=8
EMBED_RPM=90

# Generation budget. The thinking models (Gemini 2.5+ / 3.x) spend output
# tokens on internal reasoning before writing anything - with a small budget
# they return nothing after a long wait. THINKING_BUDGET=0 turns reasoning
# off, which is right for grounded Q&A. Set it to "auto" to let the model
# decide, and raise MAX_OUTPUT_TOKENS if you do.
MAX_OUTPUT_TOKENS=2048
THINKING_BUDGET=0



# Hard ceiling on any single Gemini call, in seconds. The SDK has no default
# timeout, so without this a stalled request hangs forever.
REQUEST_TIMEOUT=120
